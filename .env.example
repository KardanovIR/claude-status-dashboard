# Port to listen on
PORT=3000

# Bind address
HOST=0.0.0.0

# Public URL of this service (shown in the UI and used for the webhook URL).
# Example: https://claude-status.fly.dev
PUBLIC_URL=http://localhost:3000

# Optional shared secret. If set, webhook requests must include:
#   X-Webhook-Secret: <value>
WEBHOOK_SECRET=

# Optional: auto-remove sessions not updated in N ms (0 = keep forever)
SESSION_TTL_MS=0
