# ─── Core ─────────────────────────────────────────────────────────────────────

# Port to listen on. With docker-compose this is also the host port the
# dashboard is published on (container always listens on 3000).
PORT=3000

# Bind address.
HOST=0.0.0.0

# Public base URL of this service. Used to build the dashboard/webhook URLs
# returned by the API and shown in the UI. Set to your real URL in production.
# Example: https://status.example.com
PUBLIC_URL=http://localhost:3000

# ─── Mode ─────────────────────────────────────────────────────────────────────

# Multi-tenant workspace mode. When true, all sessions live in per-workspace
# namespaces under /w/<token>/... and the legacy global endpoints
# (/webhook, /events, /api/sessions) return 404.
# Leave unset/false for single-user self-hosting (exact v1 behavior).
# Mainly for running a shared/public instance.
#MULTI_TENANT=true

# ─── Auth (legacy mode only) ──────────────────────────────────────────────────

# Optional shared secret for the single-tenant deployment. If set,
# POST /webhook and POST /sessions/clear must include the header:
#   X-Webhook-Secret: <value>
# Note: DELETE /sessions/:id and the read endpoints stay open so the dashboard
# can list and dismiss cards — don't expose a legacy instance publicly if that
# matters (use multi-tenant mode instead).
# Ignored in multi-tenant mode (the workspace token in the URL is the auth).
WEBHOOK_SECRET=

# ─── Sessions ─────────────────────────────────────────────────────────────────

# Auto-remove sessions not updated in N milliseconds.
# Default when unset: 0 (keep forever) in legacy mode,
#                     86400000 (24 hours) in multi-tenant mode.
SESSION_TTL_MS=

# Hard ceiling on the number of live workspaces (multi-tenant mode only).
# Creation returns 503 at the cap. Default: 10000.
#MAX_WORKSPACES=10000

# ─── Persistence ──────────────────────────────────────────────────────────────

# PostgreSQL connection string. Empty/unset = in-memory only: sessions (and
# workspaces, in multi-tenant mode) are lost on restart. Self-hosters who
# don't mind losing cards on restart can leave this empty.
# Note: docker-compose defaults this to the bundled postgres service
# (postgres://agstatus:$POSTGRES_PASSWORD@postgres:5432/agstatus) unless you
# set it here. Rows are soft-deleted (flagged, never removed) — see
# docs/self-hosting.md. Migrating from the old SQLite storage:
#   node scripts/migrate-sqlite-to-postgres.js ./data/agstatus.db "$DATABASE_URL"
#DATABASE_URL=postgres://agstatus:agstatus@postgres:5432/agstatus

# Password for the bundled docker-compose postgres service (defaults to
# "agstatus"; change it for anything non-local).
#POSTGRES_PASSWORD=agstatus

# ─── Reverse proxy / TLS ──────────────────────────────────────────────────────

# Set to 1 when the app runs behind a reverse proxy (Caddy, nginx, a platform
# load balancer) so client IPs are taken from X-Forwarded-For. Required for
# correct per-IP rate limiting on a public instance.
#TRUST_PROXY=1

# Domain for the bundled Caddy reverse proxy (docker compose --profile tls).
# Only used by the caddy service, not by the app itself. When set, also point
# PUBLIC_URL at https://<this domain> and set TRUST_PROXY=1.
#DOMAIN=status.example.com

# ─── Push notifications (APNs) ────────────────────────────────────────────────

# Apple Push Notification service credentials — hosted instance only.
# Self-hosts without a key simply don't send pushes: the server runs exactly
# as before, GET /api/config just reports "push": false. If the block is only
# partially set (or the key can't be read) the server logs one warning and
# disables push; it never fails to start.

# Path to the .p8 auth key downloaded from developer.apple.com
# (alternatively set APNS_KEY to the PEM content itself).
#APNS_KEY_PATH=/app/keys/AuthKey_ABC123DEFG.p8

# The 10-character key id of that .p8 key.
#APNS_KEY_ID=ABC123DEFG

# Your Apple Developer team id (10 characters).
#APNS_TEAM_ID=TEAM123456

# The app's bundle id (the apns-topic header).
#APNS_TOPIC=com.kardanov.agstatus

# sandbox (default) targets api.sandbox.push.apple.com — for development
# builds. production targets api.push.apple.com — for TestFlight/App Store.
#APNS_ENV=sandbox
