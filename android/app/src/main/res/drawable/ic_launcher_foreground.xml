<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS icon's 2×2 grid of status tiles: planning, coding, testing, done,
     reading left to right and top to bottom. The 43dp block stays inside the
     66dp adaptive-icon safe circle so no launcher mask can clip a corner.

     Solid fills, in the four tokens exactly. Each tile used to be a two-stop
     vertical gradient between two hand-typed hexes — eight values that belonged
     to no token, from the palette this release retires — and at launcher size
     a 19dp gradient is invisible anyway: it was gloss, not information.

     In the new palette the four run violet → blue → teal → green, which is the
     hue sweep of the board's own state order rather than four unrelated hues. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- planning: oklch(78% 0.100 320) -->
    <path
        android:fillColor="#D4A3DF"
        android:pathData="M37,32.5 h10 a4.5,4.5 0 0 1 4.5,4.5 v10 a4.5,4.5 0 0 1 -4.5,4.5 h-10 a4.5,4.5 0 0 1 -4.5,-4.5 v-10 a4.5,4.5 0 0 1 4.5,-4.5 z" />
    <!-- coding: oklch(74% 0.085 240) -->
    <path
        android:fillColor="#78B2DB"
        android:pathData="M61,32.5 h10 a4.5,4.5 0 0 1 4.5,4.5 v10 a4.5,4.5 0 0 1 -4.5,4.5 h-10 a4.5,4.5 0 0 1 -4.5,-4.5 v-10 a4.5,4.5 0 0 1 4.5,-4.5 z" />
    <!-- testing: oklch(74% 0.080 200) -->
    <path
        android:fillColor="#69BABF"
        android:pathData="M37,56.5 h10 a4.5,4.5 0 0 1 4.5,4.5 v10 a4.5,4.5 0 0 1 -4.5,4.5 h-10 a4.5,4.5 0 0 1 -4.5,-4.5 v-10 a4.5,4.5 0 0 1 4.5,-4.5 z" />
    <!-- done: oklch(76% 0.125 155) — the accent, and the brightest tile -->
    <path
        android:fillColor="#69C88E"
        android:pathData="M61,56.5 h10 a4.5,4.5 0 0 1 4.5,4.5 v10 a4.5,4.5 0 0 1 -4.5,4.5 h-10 a4.5,4.5 0 0 1 -4.5,-4.5 v-10 a4.5,4.5 0 0 1 4.5,-4.5 z" />
