<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors Theme.kt / Theme.swift, which mirror public/tokens.css. The
         board is always dark, so there is no -night variant of any of these.

         Keep these in step with Theme.kt by hand: a Compose colour cannot be
         referenced from a platform theme, and the platform theme is what paints
         the window before the first frame of Compose exists. -->
    <color name="agstatus_background">#0C0F0D</color>
    <!-- oklch(76% 0.125 155), Theme.accent. Was agstatus_coding, #B17AFF —
         the retired purple, still being handed to android:colorAccent long
         after the Compose layer had stopped using it. -->
    <color name="agstatus_accent">#69C88E</color>

    <color name="ic_launcher_background">#0C0F0D</color>
</resources>
