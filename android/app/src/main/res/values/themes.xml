<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform Material dark theme: Compose Material3 supplies the real
         design system, this only keeps the window itself from flashing light. -->
    <style name="Theme.AgStatus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/agstatus_background</item>
        <item name="android:colorBackground">@color/agstatus_background</item>
        <item name="android:colorAccent">@color/agstatus_coding</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/agstatus_background</item>
        <item name="android:navigationBarColor">@color/agstatus_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
