# Caddyfile for the claude-status dashboard.
#
# Usage:
#   1. Point your domain's DNS (A/AAAA record) at this host and open ports 80/443.
#   2. In .env set:
#        DOMAIN=status.example.com
#        PUBLIC_URL=https://status.example.com
#        TRUST_PROXY=1
#   3. Start the stack with the TLS profile:
#        docker compose --profile tls up -d
#
# Caddy obtains and renews a Let's Encrypt certificate for $DOMAIN automatically.

{$DOMAIN} {
	# "dashboard" is the app service name in docker-compose.yml.
	# flush_interval -1 disables response buffering so Server-Sent Events
	# (/events and /w/<token>/events) stream immediately.
	reverse_proxy dashboard:3000 {
		flush_interval -1
	}

	# No `log` directive on purpose. If you add one, leave `log_credentials`
	# at its default (off): Caddy serializes the whole request header map into
	# the access log, and only with log_credentials off does it redact
	# Authorization — which is where a Focus listener carries its machine key
	# (docs/design/focus-protocol.md §3.2). The board token is in the request
	# PATH and cannot be redacted at all, so an access log here is a list of
	# credentials either way; keep it off, or keep it somewhere you would keep
	# passwords.
}
