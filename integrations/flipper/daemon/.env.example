# Dashboard server whose /events SSE stream the daemon subscribes to.
DASHBOARD_URL=http://localhost:3000

# Optional: connect only to a Flipper with this exact BLE name.
# Leave empty to match any device advertising as "Flipper <name>".
FLIPPER_NAME=

# Max tasks to show on the Flipper screen (fits ~4 rows).
MAX_TASKS=4

# Include sessions whose status is "done".
SHOW_DONE=false

# Debounce window (ms) for coalescing bursts of updates before redrawing.
DEBOUNCE_MS=150
