<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Driven by the APS_ENVIRONMENT build setting: "development" in Debug
	     (APNs sandbox), "production" in Release. A hardcoded "development"
	     either fails upload validation (ITMS-90164) or ships an app whose
	     device tokens only ever work against the sandbox. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
